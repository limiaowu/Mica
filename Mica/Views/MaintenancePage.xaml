<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Mica.Views.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mica.Views"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- 笔记本维护覆盖页（主从）。两个入口（详情页菜单 / 主页多选）都进这里，复用同一份页面：
         左列＝被分析的笔记本（≥2 个时顶部加「总览」）；右侧＝NotebookReportView（或总览聚合）。
         单个笔记本入口时左列收起、右侧直接显示。扫描在后台线程跑，期间显示 LoadingPanel。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 重新扫描。无返回箭头——标题栏已有前进/后退（与笔记本/设置页对齐）。 -->
        <Grid Grid.Row="0" Padding="28,24,28,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="笔记本维护" FontSize="28" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Click="OnRescan" VerticalAlignment="Center"
                    ToolTipService.ToolTip="重新扫描">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="重新扫描"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 主从主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：笔记本列表（单个入口时整列收起） -->
            <Border x:Name="LeftPanel" Grid.Column="0" Width="248"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0">
                <ListView x:Name="TargetList" SelectionMode="Single"
                          SelectionChanged="OnTargetSelected" Padding="8,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MaintTarget">
                            <StackPanel Spacing="2" Padding="4,6">
                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 右侧：加载 / 总览 / 单笔记本报告，三选一显示 -->
            <Grid Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0">

                <!-- 扫描中 -->
                <StackPanel x:Name="LoadingPanel" Spacing="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="40" Height="40"/>
                    <TextBlock x:Name="LoadingText" Text="正在扫描…" FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- 总览聚合 -->
                <ScrollViewer x:Name="OverviewScroll" Padding="28,20,28,28"
                              HorizontalScrollMode="Disabled" Visibility="Collapsed">
                    <StackPanel Spacing="22" MaxWidth="900">
                        <TextBlock x:Name="OverviewTitle" FontSize="22" FontWeight="SemiBold"/>
                        <ItemsRepeater x:Name="OverviewCards">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="150" MinItemHeight="64"
                                                   MinRowSpacing="10" MinColumnSpacing="10"
                                                   ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:StatCard">
                                    <Border CornerRadius="8" Padding="14,10"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Label}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="SemiBold"/>
                                            <TextBlock Text="{x:Bind Sub}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{x:Bind HasSub}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <StackPanel Spacing="10">
                            <TextBlock Text="各笔记本" FontSize="15" FontWeight="SemiBold"/>
                            <Border CornerRadius="8" Padding="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ItemsControl x:Name="OverviewList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MaintTarget">
                                            <Grid Padding="10,8" ColumnSpacing="12" Background="Transparent"
                                                  Tapped="OnOverviewRowTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Subtitle}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 单笔记本报告（复用） -->
                <local:NotebookReportView x:Name="ReportView" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
