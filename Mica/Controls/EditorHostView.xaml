<UserControl
    x:Class="Mica.Controls.EditorHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- AllowDrop + 拖放处理放在这层 Grid（而非 WebView2）：WinUI3 未打包应用里 WebView2 转发「外部文件」
         拖放不可靠（一路显示 ⊘），故把 WebView2.AllowExternalDrop 关掉、让外部文件拖放落到这层 Grid 由宿主接管，
         读出文件路径 + 落点坐标后经 IPC 交回 web 插入（见 .xaml.cs OnRootDrop / MainWindow.Image 的 OnEditorImagesDropped）。 -->
    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True">
        <!-- WebView2 renders into its own composited surface, so it can't be clipped
             to rounded corners by a Border CornerRadius (and a Composition geometric
             clip also failed to take visually). Editor 圆角暂不做，见 CLAUDE.md 远期规划。 -->
        <muxc:WebView2 x:Name="EditorWebView" />
        <ProgressRing x:Name="LoadingRing"
                      IsActive="True"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="32" Height="32" />
    </Grid>
</UserControl>
